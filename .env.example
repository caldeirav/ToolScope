# OpenAI-compatible chat completions (/v1). Change these to switch hosts
# (llama.cpp, vLLM, a cloud gateway, OpenAI, …). The eval runner reads only these names.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=local

# Local GGUF model cache (eval/local/scripts/download_models.sh)
TOOLSCOPE_MODEL_CACHE=eval/local/models

# Hugging Face token for gated GGUF repos (optional)
# HF_TOKEN=

# Google Gemini (optional; used when a model entry has provider: google)
GOOGLE_API_KEY=
